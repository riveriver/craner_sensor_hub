# Optional zperf minimal network test configuration.
#
# Usage:
#   .\build.ps1 -SkipOtaImages -ExtraConf zperf.config
#
# This overlay disables the normal business threads and enables only the
# network pieces needed for zperf UDP/TCP testing over Ethernet.

CONFIG_SHELL=y
CONFIG_SHELL_BACKEND_SERIAL=y
CONFIG_SHELL_BACKEND_TELNET=n
CONFIG_SHELL_LOG_BACKEND=n

CONFIG_LOG=y
CONFIG_LOG_BACKEND_UART=y
CONFIG_LOG_BACKEND_NET=n

CONFIG_NET_UDP=y
CONFIG_NET_TCP=y
CONFIG_NET_SOCKETS=y
CONFIG_NET_SHELL=y
CONFIG_NET_ZPERF=y
CONFIG_NET_ZPERF_SERVER=y
CONFIG_NET_ZPERF_MAX_PACKET_SIZE=1472

CONFIG_NET_STATISTICS=y
CONFIG_NET_STATISTICS_ETHERNET=y
CONFIG_NET_MAX_CONN=16
CONFIG_NET_MAX_CONTEXTS=16
CONFIG_NET_PKT_RX_COUNT=64
CONFIG_NET_PKT_TX_COUNT=64
CONFIG_NET_BUF_RX_COUNT=128
CONFIG_NET_BUF_TX_COUNT=32
CONFIG_NET_BUF_DATA_SIZE=1536
CONFIG_NET_TC_TX_COUNT=1
CONFIG_NET_SOCKETS_SERVICE_THREAD_PRIO=-1
CONFIG_ZVFS_POLL_MAX=9
CONFIG_SPEED_OPTIMIZATIONS=y
CONFIG_TIMESLICING=n

CONFIG_CRANER_ENABLE_SYSTEM_HEALTH_THREAD=n
CONFIG_CRANER_ENABLE_READ_SLEWING_ENCODER_THREAD=n
CONFIG_CRANER_ENABLE_READ_LUFFING_ENCODER_THREAD=n
CONFIG_CRANER_ENABLE_READ_HOISTING_ENCODER_THREAD=n
CONFIG_CRANER_ENABLE_OTA_CONTROL=n
