menu "Encoder application"
	depends on ENCODER_SAMPLE_SERVICE

choice ENCODER_MODEL
	prompt "Encoder backend model"
	default ENCODER_MODEL_IDECODER_MODBUS

config ENCODER_MODEL_IDECODER_MODBUS
	bool "IDECODER Modbus encoder"
	select IDECODER_ENCODER_MODBUS

endchoice

config ENABLE_SLEWING_ENCODER
	bool "Enable slewing encoder"
	default y

config ENABLE_LUFFING_ENCODER
	bool "Enable luffing encoder"
	default y if TOWER_TYPE_FLAT_TOP
	depends on !TOWER_TYPE_LUFFING_JIB

config ENABLE_HOISTING_ENCODER
	bool "Enable hoisting encoder"
	default y

config ENCODER_SLEWING_IFACE_NAME
	string "Slewing encoder RS485 interface name"
	default "rs485-uart7"
	depends on ENABLE_SLEWING_ENCODER

config ENCODER_LUFFING_IFACE_NAME
	string "Luffing encoder RS485 interface name"
	default "rs485-uart8"
	depends on ENABLE_LUFFING_ENCODER

config ENCODER_HOISTING_IFACE_NAME
	string "Hoisting encoder RS485 interface name"
	default "rs485-uart4"
	depends on ENABLE_HOISTING_ENCODER

config ENCODER_MODBUS_UNIT_ID
	int "Encoder Modbus unit id"
	default 1
	range 1 247

config ENCODER_MODBUS_BAUD
	int "Encoder Modbus baud rate"
	default 9600

config ENCODER_MODBUS_RX_TIMEOUT_MS
	int "Encoder Modbus RX timeout in milliseconds"
	default 30

config ENCODER_SAMPLE_PERIOD_MS
	int "Encoder sample period in milliseconds"
	default 50
	range 10 10000

config ENCODER_MODBUS_START_ADDR
	hex "Encoder Modbus holding register start address"
	default 0x0002

endmenu
