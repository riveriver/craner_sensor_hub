source "Kconfig.zephyr"

rsource "module/system_health_service/Kconfig"
rsource "module/modbus_register_service/Kconfig"
rsource "module/modbus_tcp_server_service/Kconfig"
rsource "module/imu_sample_service/Kconfig"
rsource "module/encoder_sample_service/Kconfig"
rsource "module/anemometer_sample_service/Kconfig"
rsource "app/luffing_imu_app/Kconfig"
rsource "app/encoder_app/Kconfig"
rsource "app/anemometer_app/Kconfig"

menu "Craner Encoder Hub application"

config LOCAL_TIMEZONE_OFFSET_MINUTES
	int "Local timezone offset in minutes"
	default 480
	range -720 840
	help
	  Local timezone offset used for human-readable logs, shell status, and
	  local maintenance schedules. The default is UTC+8.

choice TOWER_TYPE
	prompt "Tower crane type"
	default TOWER_TYPE_FLAT_TOP

config TOWER_TYPE_FLAT_TOP
	bool "Flat-top tower crane"
	help
	  Flat-top tower crane with slewing, luffing and hoisting encoders.

config TOWER_TYPE_LUFFING_JIB
	bool "Luffing-jib tower crane"
	select WIT_IMU_MODBUS
	help
	  Luffing-jib tower crane with the luffing encoder replaced by a
	  WIT Modbus RTU IMU.

endchoice

config ENABLE_OTA_CONTROL
	bool "Enable MCUboot swap OTA control shell"
	default y
	depends on SHELL && FLASH && FLASH_MAP && IMG_MANAGER && MCUBOOT_IMG_MANAGER
	help
	  Enable shell commands that drive MCUboot's standard swap-based OTA
	  state machine.

config ENABLE_STORAGE_SERVICE
	bool "Enable persistent storage service skeleton"
	default y
	depends on FLASH && FLASH_MAP
	help
	  Enable the persistent storage service skeleton. The first
	  implementation only probes internal flash partitions and exposes
	  their status through shell diagnostics.

config ENABLE_COREDUMP_SERVICE
	bool "Enable coredump diagnostic service"
	default y
	depends on ENABLE_STORAGE_SERVICE
	depends on DEBUG_COREDUMP && DEBUG_COREDUMP_BACKEND_FLASH_PARTITION
	help
	  Enable project-level coredump diagnostics. This wraps Zephyr's
	  coredump flash backend with simple status and clear APIs for shell
	  and future remote diagnostics.

config ENABLE_DEVICE_PARAM_STORE
	bool "Enable device parameter store"
	default y
	depends on ENABLE_STORAGE_SERVICE && SETTINGS && SETTINGS_NVS
	depends on NET_HOSTNAME_ENABLE
	help
	  Enable the device parameter service backed by Zephyr settings/NVS.
	  It owns the device parameter schema and exposes controlled get, set,
	  save, and factory reset APIs for shell and remote maintenance.

config COREDUMP_EXPORT_CHUNK_BYTES
	int "Coredump export chunk size in bytes"
	default 128
	range 32 256
	depends on ENABLE_COREDUMP_SERVICE
	help
	  Number of raw coredump bytes read per export chunk. The exported
	  payload is hex encoded, so each shell chunk is about twice this size
	  plus the #CD: prefix.

config ENABLE_FAULT_INJECTION_SHELL
	bool "Enable fault injection shell commands"
	default n
	depends on SHELL
	help
	  Enable local shell commands that deliberately trigger fatal errors
	  for coredump validation. Keep this disabled in production builds.

config NETWORK_DHCP_RETRY_INITIAL_MS
	int "Initial DHCP retry delay in milliseconds"
	default 5000
	range 1000 60000
	help
	  Delay used for the first DHCP retry after startup DHCP timeout or
	  address loss.

config NETWORK_DHCP_RETRY_MAX_MS
	int "Maximum DHCP retry delay in milliseconds"
	default 60000
	range 5000 600000
	help
	  Maximum delay used by the DHCP exponential backoff retry loop.

config OTA_TEST_TIMEOUT_S
	int "OTA test image confirmation timeout in seconds"
	default 3600
	depends on ENABLE_OTA_CONTROL
	help
	  Time allowed for an unconfirmed test image to call ota confirm before
	  the application reboots and lets MCUboot roll back.

config TIME_SERVICE_STACK_SIZE
	int "Time service thread stack size"
	default 4096
	range 2048 8192
	help
	  Stack size for the time service thread. The thread performs blocking
	  SNTP/DNS operations and updates Zephyr realtime clock.

config TIME_SERVICE_NTP_SERVER
	string "NTP server hostname"
	default "pool.ntp.org"
	help
	  NTP/SNTP server used by the time service after DHCP succeeds.

config TIME_SERVICE_NTP_TIMEOUT_MS
	int "NTP query timeout in milliseconds"
	default 5000
	range 1000 30000
	help
	  Timeout used for a single SNTP request.

config TIME_SERVICE_NTP_RETRY_INITIAL_MS
	int "Initial NTP retry delay in milliseconds"
	default 10000
	range 1000 60000
	help
	  Delay used for the first NTP retry after a sync failure.

config TIME_SERVICE_NTP_RETRY_MAX_MS
	int "Maximum NTP retry delay in milliseconds"
	default 300000
	range 10000 3600000
	help
	  Maximum delay used by the NTP exponential backoff retry loop.

config TIME_SERVICE_NTP_RESYNC_INTERVAL_S
	int "NTP resync interval in seconds"
	default 3600
	range 60 86400
	help
	  Periodic resync interval after a successful NTP sync.

config TIME_SERVICE_RTC_MIN_VALID_UNIX_TIME
	int "Minimum valid RTC Unix time"
	default 1767225600
	help
	  Minimum Unix timestamp accepted as a valid RTC time. The default is
	  2026-01-01T00:00:00Z.

config TIME_SERVICE_RTC_WRITEBACK_THRESHOLD_S
	int "RTC writeback threshold in seconds"
	default 2
	range 0 3600
	help
	  Write a synchronized time source back to RTC only when the absolute
	  difference from the current RTC value is at least this many seconds.

endmenu
