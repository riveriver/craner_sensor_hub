menu "Modbus TCP server service"

config MODBUS_TCP_SERVER_SERVICE
	bool "Enable Modbus TCP server service"
	default n
	depends on MODBUS && NET_TCP && NET_SOCKETS && POSIX_API
	depends on MODBUS_REGISTER_SERVICE
	help
	  Enable the reusable Modbus TCP server service. The service accepts
	  Modbus TCP clients and forwards requests to Zephyr's Modbus RAW server
	  callbacks backed by modbus_register_service.

if MODBUS_TCP_SERVER_SERVICE

config MODBUS_TCP_SERVER_PORT
	int "Modbus TCP server port"
	default 502
	range 1 65535

config MODBUS_TCP_SERVER_MAX_CLIENTS
	int "Maximum simultaneous Modbus TCP clients"
	default 4
	range 1 8
	help
	  Maximum number of Modbus TCP clients served at the same time. The
	  server uses a fixed poll-based client pool, so this value should be
	  matched with NET_MAX_CONTEXTS, NET_MAX_CONN, and ZVFS_POLL_MAX.

config MODBUS_TCP_SERVER_STACK_SIZE
	int "Modbus TCP server thread stack size"
	default 3072
	range 2048 8192

config MODBUS_TCP_SERVER_PRIORITY
	int "Modbus TCP server thread priority"
	default 8
	range 0 15

config MODBUS_TCP_SERVER_RECV_TIMEOUT_MS
	int "Modbus TCP receive timeout in milliseconds"
	default 1000
	range 100 30000

config MODBUS_TCP_SERVER_RAW_IFACE_NAME
	string "Modbus RAW interface name"
	default "RAW_0"

config MODBUS_TCP_SERVER_CUSTOM_FC_EXAMPLE
	bool "Enable example custom function code"
	default n
	help
	  Enable custom Modbus function code 101 that returns fixed diagnostic
	  data. Keep this disabled for production firmware unless a product
	  explicitly needs it.

endif

endmenu
