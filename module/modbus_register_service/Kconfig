menu "Modbus register service"

config MODBUS_REGISTER_SERVICE
	bool "Enable Modbus register service"
	default n
	help
	  Enable the reusable Modbus register map service. The service owns
	  coil, input register, and holding register read/write APIs and can be
	  shared by Modbus TCP, Modbus RTU, shell, and product application code.

if MODBUS_REGISTER_SERVICE

config MODBUS_REGISTER_STORE
	bool "Enable persistent Modbus register store"
	default n
	depends on FLASH && FLASH_MAP
	help
	  Save Modbus registers marked with MODBUS_REG_F_PERSISTENT to flash.
	  The current backend expects a fixed partition node label named
	  modbus_store_partition.

config MODBUS_REGISTER_STORE_SAVE_DELAY_MS
	int "Modbus register store delayed save time in milliseconds"
	default 3000
	range 100 60000
	depends on MODBUS_REGISTER_STORE
	help
	  Delay used to merge frequent Modbus writes before saving persistent
	  registers to flash.

endif

endmenu
