config ANEMOMETER_SAMPLE_SERVICE
	bool "Anemometer sample service"
	help
	  Enable the reusable one-channel anemometer sampling service.

if ANEMOMETER_SAMPLE_SERVICE

config ANEMOMETER_SAMPLE_SERVICE_THREAD_STACK_SIZE
	int "Anemometer sample service thread stack size"
	default 2048
	range 1024 4096

config ANEMOMETER_SAMPLE_SERVICE_THREAD_PRIORITY
	int "Anemometer sample service thread priority"
	default 6
	range 0 15

config ANEMOMETER_SAMPLE_SERVICE_MAX_INSTANCES
	int "Maximum anemometer sample service instances"
	default 2
	range 1 8

config ANEMOMETER_SAMPLE_SERVICE_STATS
	bool "Enable anemometer sample statistics"
	default y
	help
	  Enable success and error counters, consecutive error statistics, and
	  read duration statistics.

config ANEMOMETER_SAMPLE_SERVICE_SHELL
	bool "Enable anemometer sample shell commands"
	default y
	depends on SHELL && ANEMOMETER_SAMPLE_SERVICE_STATS
	help
	  Enable anemometer sample service shell diagnostics.

config ANEMOMETER_SAMPLE_SERVICE_REINIT_ON_ENODEV
	bool "Reinitialize anemometer backend when ENODEV is returned"
	default y
	help
	  Reset the backend client and run backend init again before the next
	  sample when a fetch returns -ENODEV.

endif
