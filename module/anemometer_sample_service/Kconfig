config ANEMOMETER_SAMPLE_SERVICE
	bool "Anemometer sample service"
	help
	  Enable the reusable one-channel anemometer sampling service.

if ANEMOMETER_SAMPLE_SERVICE

config ANEMOMETER_SAMPLE_SERVICE_THREAD_STACK_SIZE
	int "Anemometer sample service thread stack size"
	default 2048
	range 1024 4096

config ANEMOMETER_SAMPLE_SERVICE_THREAD_PRIORITY
	int "Anemometer sample service thread priority"
	default 6
	range 0 15

config ANEMOMETER_SAMPLE_SERVICE_MAX_INSTANCES
	int "Maximum anemometer sample service instances"
	default 2
	range 1 8

endif
