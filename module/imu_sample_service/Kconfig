menu "IMU sample service"

config IMU_SAMPLE_SERVICE
	bool "Enable IMU sample service"
	default y if TOWER_TYPE_LUFFING_JIB
	help
	  Enable a reusable one-channel IMU sampling service. Product code can
	  create multiple instances, one per IMU channel.

config IMU_SAMPLE_THREAD_STACK_SIZE
	int "IMU sample thread stack size"
	default 2048
	depends on IMU_SAMPLE_SERVICE

config IMU_SAMPLE_THREAD_PRIORITY
	int "IMU sample thread priority"
	default 7
	depends on IMU_SAMPLE_SERVICE

config IMU_SAMPLE_SERVICE_MAX_INSTANCES
	int "Maximum IMU sample service instances"
	default 4
	range 1 8
	depends on IMU_SAMPLE_SERVICE

config IMU_SAMPLE_SERVICE_STATS
	bool "Enable IMU sample statistics"
	default y
	depends on IMU_SAMPLE_SERVICE
	help
	  Enable success and error counters, consecutive error statistics, and
	  read duration statistics.

config IMU_SAMPLE_SERVICE_SHELL
	bool "Enable IMU sample shell commands"
	default y
	depends on IMU_SAMPLE_SERVICE && SHELL && IMU_SAMPLE_SERVICE_STATS
	help
	  Enable IMU sample service shell diagnostics.

config IMU_SAMPLE_SERVICE_REINIT_ON_ENODEV
	bool "Reinitialize IMU backend when ENODEV is returned"
	default y
	depends on IMU_SAMPLE_SERVICE
	help
	  Reset the backend client and run backend init again before the next
	  sample when a fetch returns -ENODEV.

endmenu
