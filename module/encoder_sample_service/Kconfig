config ENCODER_SAMPLE_SERVICE
	bool "Encoder sample service"
	help
	  Enable the reusable one-channel encoder sampling service.

if ENCODER_SAMPLE_SERVICE

config ENCODER_SAMPLE_SERVICE_THREAD_STACK_SIZE
	int "Encoder sample service thread stack size"
	default 2048
	range 1024 4096

config ENCODER_SAMPLE_SERVICE_THREAD_PRIORITY
	int "Encoder sample service thread priority"
	default 6
	range 0 15

config ENCODER_SAMPLE_SERVICE_MAX_INSTANCES
	int "Maximum encoder sample service instances"
	default 4
	range 1 8

config ENCODER_SAMPLE_SERVICE_STATS
	bool "Enable encoder sample statistics"
	default y
	help
	  Enable success and error counters, consecutive error statistics, and
	  read duration statistics.

config ENCODER_SAMPLE_SERVICE_SHELL
	bool "Enable encoder sample shell commands"
	default y
	depends on SHELL && ENCODER_SAMPLE_SERVICE_STATS
	help
	  Enable encoder sample service shell diagnostics.

config ENCODER_SAMPLE_SERVICE_REINIT_ON_ENODEV
	bool "Reinitialize encoder backend when ENODEV is returned"
	default y
	help
	  Reset the backend client and run backend init again before the next
	  sample when a fetch returns -ENODEV.

endif
